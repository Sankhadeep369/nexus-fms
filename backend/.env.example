# Copy this file to .env and fill in your values.
# The backend picks these up automatically via pydantic-settings.

# --- HuggingFace (needed to download the GGUF on first run) ---
HF_TOKEN=your_hf_token_here

# --- Inference backend ---
# "local"  -> runs the GGUF on-device via llama.cpp (default)
# "groq"   -> routes inference to Groq API (fast, free tier, good for cloud POC)
LLM_BACKEND=local

# --- Groq (only needed when LLM_BACKEND=groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173

# --- Cache TTL (seconds) ---
CACHE_TTL_SECONDS=604800
