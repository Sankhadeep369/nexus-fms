# Copy this file to .env and fill in your values.
# The backend picks these up automatically via pydantic-settings.

# -----------------------------------------------------------------------
# LOCAL DEVELOPMENT OVERRIDES
# On a fresh clone the app is fully self-contained — corpus lives in
# backend/data/corpus/ and the GGUF is downloaded from HF Hub into
# backend/data/models/ on first run.
#
# If you have the full NEXUS project tree checked out, point these at
# the original folders to avoid duplication:
#   GGUF_DIR=D:/NEXUS/06_model_artifacts/gguf
#   CORPUS_DIR=D:/NEXUS/02_extracted_text
# -----------------------------------------------------------------------

# --- HuggingFace (needed to download the GGUF on first run if repo is private) ---
HF_TOKEN=your_hf_token_here

# --- Inference backend ---
# "local"       -> runs the GGUF on-device via llama.cpp (default)
# "hf_endpoint" -> routes inference to a HuggingFace Inference Endpoint
LLM_BACKEND=local

# --- HF Inference Endpoint (only needed when LLM_BACKEND=hf_endpoint) ---
HF_ENDPOINT_URL=
# HF_TOKEN above is reused for endpoint auth

# --- Path overrides (leave blank to use repo-relative defaults) ---
# GGUF_DIR=
# CORPUS_DIR=

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173

# --- Cache TTL (seconds, default 7 days) ---
CACHE_TTL_SECONDS=604800
